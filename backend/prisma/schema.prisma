// Prisma Schema for Pet Care Management Platform (MongoDB Provider)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  CARE_STAFF
  WAREHOUSE_STAFF
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StockTxType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ProposalStatus {
  DRAFT
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  password     String
  fullName     String
  phone        String?
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  pets         Pet[]
  appointments Appointment[] @relation("CustomerAppointments")
  assignedCare Appointment[] @relation("StaffAppointments")
  orders       Order[]
}

model Pet {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  species        String        // Chó, Mèo, Chim, Thỏ...
  breed          String?       // Corgi, Poodle, Mèo Anh Lông Dài...
  ageMonths      Int?
  weightKg       Float?
  medicalHistory String?
  ownerId        String        @db.ObjectId
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  appointments   Appointment[]
}

model ServiceCatalog {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  durationMinutes Int           @default(45)
  price           Float
  category        String        // Spa, Grooming, Tiêm phòng, Khám tổng quát
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointments    Appointment[]
}

model Appointment {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  petId           String            @db.ObjectId
  pet             Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  customerId      String            @db.ObjectId
  customer        User              @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Cascade)
  staffId         String?           @db.ObjectId
  staff           User?             @relation("StaffAppointments", fields: [staffId], references: [id])
  serviceId       String            @db.ObjectId
  service         ServiceCatalog    @relation(fields: [serviceId], references: [id])
  appointmentDate DateTime
  timeSlot        String            // e.g. "09:00 - 10:00"
  status          AppointmentStatus @default(PENDING)
  notes           String?
  careSummary     String?           // Ghi chú sau khi làm xong dịch vụ
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Supplier {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
}

model Product {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  category      String             // Thức ăn, Phụ kiện, Thuốc thú y, Mỹ phẩm Spa
  sku           String             @unique
  unitPrice     Float
  costPrice     Float
  currentStock  Int                @default(0)
  minStockLevel Int                @default(10)
  maxStockLevel Int                @default(100)
  supplierId    String?            @db.ObjectId
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  transactions  StockTransaction[]
  orderItems    OrderItem[]
  proposals     ReorderProposal[]
}

model StockTransaction {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  productId     String      @db.ObjectId
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          StockTxType
  quantity      Int
  note          String?
  createdAt     DateTime    @default(now())
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String      @db.ObjectId
  customer    User        @relation(fields: [customerId], references: [id])
  totalAmount Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]
}

model OrderItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String  @db.ObjectId
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model ReorderProposal {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  productId         String         @db.ObjectId
  product           Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  suggestedQuantity Int
  reason            String         // AI lý giải: "Dự báo tăng 25% nhu cầu tuần tới, kho hiện còn dưới ngưỡng an toàn"
  confidenceScore   Float          @default(0.92)
  status            ProposalStatus @default(DRAFT)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}
